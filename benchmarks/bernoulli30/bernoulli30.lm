static "laminaCore"

func printf(fmt text, ...) -> int = "printf"

func binomial(n int, k int) -> int {
    if k == 0 or k == n {
        1
    } else {
        binomial(n - 1, k - 1) + binomial(n - 1, k)
    }
}

func bernoulli(n int) -> frac {
    if n == 0 {
        1.0
    }
    if n == 1 {
        -0.5
    } 
    if n % 2 == 1 and n > 1 {
        0.0
    }
    let sum = 0.0

    let k = 0
    loop {
        if k >= n {
            break
        }
        sum = sum + ((binomial(n, k) / 1) * bernoulli(k) / (n - k + 1 / 1))
    }
    -sum
}

printf("%f\n", bernoulli(30))
